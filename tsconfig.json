{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik", "strict": true, "skipLibCheck": true,
    "allowJs": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["vite/client", "node"], "noEmit": true
  },
  "include": ["src", "*.ts", "adapters"]
}
